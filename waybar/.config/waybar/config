{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar at the bottom of your screen
    "height": 26, // Waybar height
    // Choose the order of the modules
    "modules-left": [
        "custom/ws#w1",
        "custom/ws#w2",
        "custom/ws#w3",
        "custom/ws#w4",
        "custom/ws#w5",
        "custom/ws#w6",
        "custom/ws#w7",
        "custom/ws#w8",
        "custom/ws#w9"
    ],
    "modules-center": [
        "custom/sleep-toggle",
        "clock",
        "custom/notification"
    ],
    "modules-right": [
        "backlight",
        "battery",
        "gamemode",
        "tray"
    ],
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "gamemode": {
        "format": "{glyph}",
        "format-alt": "{glyph} {count}",
        "glyph": "",
        "hide-not-running": true,
        "use-icon": true,
        "icon-name": "input-gaming-symbolic",
        "icon-spacing": 4,
        "icon-size": 20,
        "tooltip": true,
        "tooltip-format": "Games running: {count}"
    },
    // hyprland/workspaces on-click broken with Hyprland Lua IPC, see ws.sh
    "custom/ws#w1": {
        "exec": "~/.config/waybar/ws.sh 1 code",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },
    "custom/ws#w2": {
        "exec": "~/.config/waybar/ws.sh 2 www",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 2 })'"
    },
    "custom/ws#w3": {
        "exec": "~/.config/waybar/ws.sh 3 game",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 3 })'"
    },
    "custom/ws#w4": {
        "exec": "~/.config/waybar/ws.sh 4 res",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 4 })'"
    },
    "custom/ws#w5": {
        "exec": "~/.config/waybar/ws.sh 5 misc",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 5 })'"
    },
    "custom/ws#w6": {
        "exec": "~/.config/waybar/ws.sh 6 msg",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 6 })'"
    },
    "custom/ws#w7": {
        "exec": "~/.config/waybar/ws.sh 7 mail",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 7 })'"
    },
    "custom/ws#w8": {
        "exec": "~/.config/waybar/ws.sh 8 mus",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 8 })'"
    },
    "custom/ws#w9": {
        "exec": "~/.config/waybar/ws.sh 9 oc",
        "return-type": "json",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 9 })'"
    },
    "clock": {
        "format": "󰥔 {:%R  󰃭 %a %d %b %Y}",
        "tooltip": false
    },
    "battery": {
        "bat": "BAT0",
        "interval": 10,
        "states": {
            "warning": 20,
            "critical": 5
        },
        "format": "󱐋 {icon} ", // Icon: bolt
        "format-discharging": "{capacity}% {icon}",
        "format-alt": "{icon} {time}",
        "format-icons": [
            "", // Icon: battery-full
            "", // Icon: battery-three-quarters
            "", // Icon: battery-half
            "", // Icon: battery-quarter
            "" // Icon: battery-empty
        ],
        "tooltip": true,
        "tooltip-format": "{capacity}% - {timeTo}"
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='red'><sup></sup></span>",
            "none": " ",
            "dnd-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-none": " ",
            "inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "inhibited-none": " ",
            "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
            "dnd-inhibited-none": " "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/sleep-toggle": {
        "on-click": "~/.config/waybar/inhibit-sleep-toggle.sh",
        "return-type": "json",
        "interval": 30,
        "exec": "~/.config/waybar/get-sleep-status.sh",
    }
}
// vim:ft=jsonc
